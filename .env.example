# Public Cloudflare Turnstile site key (never the secret).
PUBLIC_TURNSTILE_SITE_KEY=

# Build-time contact and waitlist POST. Off until SSD-718 (job-kit Twenty field fix) is live.
PUBLIC_LEAD_INTAKE_ENABLED=false

# Public Chatwoot website-inbox token (not a secret). Widget is off when unset.
# CI reads PUBLIC_* from Azure App Configuration (not GitHub repository variables).
PUBLIC_CHATWOOT_WEBSITE_TOKEN=

# Chatwoot origin, e.g. https://support.singletonsd.com. Widget is off when unset.
PUBLIC_CHATWOOT_BASE_URL=

# Public Umami website id (not a secret). Tracker is off when unset.
# CI reads PUBLIC_* from Azure App Configuration (not GitHub repository variables).
PUBLIC_UMAMI_WEBSITE_ID=
