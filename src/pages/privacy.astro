---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Privacy policy | LeaseMate"
  description="LeaseMate privacy policy. Full text is coming soon from the product owner."
>
  <main id="main-content">
    <section class="shell legal-section" aria-labelledby="privacy-title">
      <h1 id="privacy-title">Privacy policy</h1>
      <p class="legal-effective">Coming soon</p>
      <div class="page-copy">
        <p>
          The LeaseMate privacy policy is coming soon. The product owner will
          supply the published text.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
