---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found | LeaseMate"
  description="The requested LeaseMate page could not be found."
  robots="noindex,follow"
>
  <main class="shell band" id="main-content">
    <section aria-labelledby="page-title">
      <p class="eyebrow">404</p>
      <h1 id="page-title">Page not found</h1>
      <p class="page-hero__lead">
        The page may have moved, or the address may be incorrect.
      </p>
      <p class="section-follow-link">
        <a class="text-link" href={import.meta.env.BASE_URL}
          ><span>Return home</span><span aria-hidden="true">→</span></a
        >
      </p>
    </section>
  </main>
</BaseLayout>
