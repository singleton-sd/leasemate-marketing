---
import PageHero from "../components/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page not found | LeaseMate"
  description="The requested LeaseMate page could not be found."
  robots="noindex,follow"
>
  <main id="main-content">
    <PageHero
      eyebrow="404"
      title="Page not found"
      lead="The page may have moved, or the address may be incorrect."
    >
      <p class="section-follow-link">
        <a class="text-link" href={import.meta.env.BASE_URL}
          ><span>Return home</span><span aria-hidden="true">→</span></a
        >
      </p>
    </PageHero>
  </main>
</BaseLayout>
