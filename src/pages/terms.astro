---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { requirePageEntry } from "../lib/require-page-data";

const entry = requirePageEntry(await getEntry("pages", "terms"), "terms");
const { Content } = await render(entry);
const { title, description, updated, draft } = entry.data;
---

<BaseLayout
  title={`${title} | LeaseMate`}
  description={description}
  robots={draft ? "noindex,follow" : "index,follow"}
>
  <main id="main-content">
    <section class="shell legal-section" aria-label={title}>
      <p class="legal-effective">{updated}</p>
      <div class="legal-prose">
        <Content />
      </div>
    </section>
  </main>
</BaseLayout>
