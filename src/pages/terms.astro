---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Terms of use | LeaseMate"
  description="LeaseMate terms of use. Full text is coming soon from the product owner."
>
  <main id="main-content">
    <section class="shell legal-section" aria-labelledby="terms-title">
      <h1 id="terms-title">Terms of use</h1>
      <p class="legal-effective">Coming soon</p>
      <div class="page-copy">
        <p>
          The LeaseMate terms of use are coming soon. The product owner will
          supply the published text.
        </p>
      </div>
    </section>
  </main>
</BaseLayout>
