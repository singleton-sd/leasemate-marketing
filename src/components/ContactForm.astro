---
import ContactFormIsland from "./ContactFormIsland";
import {
  parseEmailFromQuery,
  parseNameFromQuery,
  resolveRoleOption,
} from "../lib/contact-form-schema";
import { isLeadIntakeEnabled } from "../lib/lead-intake-flag";
import { withBase } from "../lib/nav";

interface Props {
  successTitle?: string;
  successBody?: string;
  submitLabel?: string;
  openingSoonTitle?: string;
  openingSoonBody?: string;
}

const {
  successTitle = "Message sent.",
  successBody = "Thank you. We will follow up by email if your enquiry needs a response.",
  submitLabel = "Send message",
  openingSoonTitle = "Contact form opening soon",
  openingSoonBody = "The contact form is temporarily closed. Check back here soon.",
} = Astro.props;

const base = import.meta.env.BASE_URL;
const privacyHref = withBase("/privacy", base);
const waitlistHref = withBase("/waitlist", base);
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as
  string | undefined;
const leadIntakeOn = isLeadIntakeEnabled(
  import.meta.env.PUBLIC_LEAD_INTAKE_ENABLED,
);

const params = Astro.url.searchParams;
const initialRole = resolveRoleOption(params.get("role")) ?? "";
const initialName = parseNameFromQuery(params.get("name"));
const initialEmail = parseEmailFromQuery(params.get("email"));
---

{
  leadIntakeOn ? (
    <ContactFormIsland
      client:load
      successTitle={successTitle}
      successBody={successBody}
      submitLabel={submitLabel}
      privacyHref={privacyHref}
      waitlistHref={waitlistHref}
      turnstileSiteKey={turnstileSiteKey}
      initialRole={initialRole}
      initialName={initialName}
      initialEmail={initialEmail}
    />
  ) : (
    <div
      class="contact-form__success"
      data-contact-opening-soon=""
      role="status"
    >
      <h2>{openingSoonTitle}</h2>
      <p>{openingSoonBody}</p>
    </div>
  )
}
