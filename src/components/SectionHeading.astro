---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: "left" | "center";
  level?: 1 | 2;
  titleId?: string;
}

const {
  eyebrow,
  title,
  lead,
  align = "left",
  level = 2,
  titleId,
} = Astro.props;

const HeadingTag = level === 1 ? "h1" : "h2";
---

<div
  class:list={[
    level === 1 ? "page-hero" : "section-heading",
    align === "center" && "section-heading--center",
  ]}
>
  <div>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <HeadingTag id={titleId}>{title}</HeadingTag>
    {
      lead && (
        <p class={level === 1 ? "page-hero__lead" : "section-heading__lead"}>
          {lead}
        </p>
      )
    }
    {
      Astro.slots.has("actions") && (
        <div class="page-hero__actions">
          <slot name="actions" />
        </div>
      )
    }
  </div>
  <slot />
</div>
